{

  "position": "top",
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "margin-top": 0,
  "margin-left": 10,
  "margin-right": 10,
  "height": 41,
  "modules-left": [
    "cpu",
    "memory",
    "disk",
    "custom/weather",
    "custom/network",
    "custom/media-title",
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "hyprland/language",
    "pulseaudio",
    "custom/microphone",
    "battery",
    "clock",
    "custom/separator",
    "group/tray"
  ],


  "group/tray": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "tray"]
  },
  "tray": {
    "icon-size": 16,
    "icon-theme": "Papirus",
    "spacing": 2,
  },
   "custom/spacer": {
        "format": " ", // Empty space
        "tooltip": false
  },
  "custom/separator": {
    "format": " | "
  },
  "custom/media-title": {
    "exec": "~/.config/waybar/scripts/media-title.sh",
    "interval": 1,
    "format": "󰎈 {}",
    "hide-empty-text": true,
    "escape": true,
    "max-length": 40,
    "tooltip": true
  },
  "bluetooth": {
    "format-connected-battery": " {device_battery_percentage}%",
    "format-connected": "",
    "format-disabled": "",
    "format-off": "",
    "format-on": "",
    "format-no-controller": "",
    "tooltip": true,
    "tooltip-format-connected-battery": "{device_alias}: {device_battery_percentage}%",
    "tooltip-format-connected": "{device_alias}"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "rewrite": {
      "": "Harsh"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
      "active": "",
      "urgent": "",
      "persistent": "",
      "focused": "",
      "default": "",

        },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 9,
      "DP-1": 9
    }
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "<span color='#89b4fa'>󰥔 </span><span color='#cdd6f4'>{:%H:%M | %a %d %b}</span>",
    "format-alt": "{:%Y-%m-%d}"
  },

  "cpu": {
    "format": "<span color='#89b4fa'>󰍛</span> <span color='#cdd6f4'>{usage}%</span>",
    "interval": 1,
    "format-alt-click": "click",
    "format-alt": "<span color='#00FF00'>{icon0}{icon1}{icon2}{icon3}</span> <span color='#FFFFFF'>{usage:>2}%</span> <span color='#00FF00'>󰍛</span>",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "gnome-system-monitor"
  },
  "memory": {
    "interval": 3,
    "format": "<span color='#f38ba8'> </span> <span color='#cdd6f4'>{used:0.1f}G</span>"
  },


"custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 600,
    "signal": 8,
    "on-click": "pkill -SIGRTMIN+8 waybar",
    "format": "{text}",
    "tooltip": true
},


  "pulseaudio": {
    "format": "<span color='#a6e3a1'>{icon} </span><span color='#cdd6f4'>{volume}%</span>",
    "format-bluetooth": "<span color='#a6e3a1'>{icon}</span>  <span color='#cdd6f4'>{volume}%</span>",
    "tooltip": false,
    "format-muted": "<span color='#f38ba8'>󰝟</span>",
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 10%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 10%-",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        "",
      ]
    }
  },
  "custom/microphone": {
    "exec": "~/.config/waybar/scripts/microphone.sh",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#a6e3a1'>{icon}</span> <span color='#cdd6f4'>{capacity}%</span>",
    "format-charging": "<span color='#a6e3a1'>󰂄</span> <span color='#cdd6f4'>{capacity}%</span>",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "custom/network": {
    "exec": "~/.config/waybar/scripts/network-speed.sh",
    "interval": 1,
    "format": "{}",
    "min-length": 8,
    "max-length": 8,
    "align": 1,
    "justify": "right",
    "on-click": "wezterm start --class Gazelle -- gazelle"
  },

   "hyprland/language": {

  "format": "<span color='#f9e2af'>󰌌</span> <span color='#cdd6f4'>{}</span>",

  "format-ar": "ara",

  "format-en": "eng",

},
  "disk":{
	"interval": 3,
  "path": "/home",
	"format": "<span color='#a6e3a1'> </span><span color='#cdd6f4'>{free}</span>",
	"unit": "GB"
},
}
