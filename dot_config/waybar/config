{

  "position": "top",
  "layer": "top",
  "exclusive": true,
  "passthrough": false,
  "margin-top": 0,
  "margin-left": 10,
  "margin-right": 10,
  "height": 41,
  "modules-left": [
    "cpu",
    "memory",
    "disk",
    "custom/weather",
    "custom/network",
    "custom/updates",
    "custom/media-title",
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/kanata",
    "custom/input",
    "bluetooth",
    "pulseaudio",
    "custom/microphone",
    "battery",
    "clock",
    "custom/separator",
    "group/tray"
  ],


  "group/tray": {
    "orientation": "horizontal",
    "modules": ["tray"]
  },
  "tray": {
    "icon-size": 16,
    "icon-theme": "Papirus",
    "spacing": 2,
  },
   "custom/spacer": {
        "format": " ", // Empty space
        "tooltip": false
  },
  "custom/separator": {
    "format": " | "
  },
  "custom/media-title": {
    "exec": "~/.config/waybar/scripts/media-title.sh",
    "interval": 5,
    "format": "󰎈 {}",
    "hide-empty-text": true,
    "escape": true,
    "min-length": 28,
    "align": 1,
    "justify": "right",
    "tooltip": true,
    "on-click": "walker --provider playerctl",
    "on-click-right": "playerctl play-pause",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next"
  },
  "bluetooth": {
    "format-connected-battery": " {device_battery_percentage:>3}%",
    "format-connected": "  --%",
    "min-length": 6,
    "align": 1,
    "justify": "right",
    "format-disabled": "",
    "format-off": "",
    "format-on": "",
    "format-no-controller": "",
    "tooltip": true,
    "tooltip-format-connected-battery": "{device_alias}: {device_battery_percentage}%",
    "tooltip-format-connected": "{device_alias}",
    "on-click": "walker --provider bluetooth"
  },
  "hyprland/window": {
    "format": "{}",
    "min-length": 35,
    "align": 1,
    "justify": "right",
    "rewrite": {
      "": "Harsh"
    },
    "separate-outputs": true
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    // Show only workspaces assigned to each bar's own output.
    "all-outputs": false,
    "sort-by": "number"
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "<span color='#cba6f7'>󰥔 </span><span color='#cba6f7'>{:%H:%M | %a %d %b}</span>",
    "format-alt": "<span color='#cba6f7'>󰥔 </span><span color='#cba6f7'>{:%H:%M | %a %d %b}</span>",
    "min-length": 20,
    "align": 1,
    "justify": "right",
    "on-click": "swaync-client --toggle-panel"
  },

  "cpu": {
    "format": "<span color='#cba6f7'>󰍛</span> <span color='#cba6f7'>{usage:>2}%</span>",
    "min-length": 5,
    "align": 1,
    "justify": "right",
    "interval": 3,
    "format-alt-click": "click",
    "format-alt": "<span color='#cba6f7'>{usage:>3}% 󰍛</span>",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "wezterm start --class Btop -- btop"
  },
  "memory": {
    "interval": 5,
    "format": "<span color='#cba6f7'> </span><span color='#cba6f7'>{used:>4.1f}G</span>",
    "min-length": 7,
    "align": 1,
    "justify": "right",
    "on-click": "wezterm start --class Btop -- btop"
  },


"custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 3600,
    "format": "{text}",
    "min-length": 5,
    "align": 1,
    "justify": "right",
    "tooltip": true,
    "on-click": "wezterm start --class SystemUpdate -- bash -lc 'yay -Syu; exec $SHELL'"
  },

"custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 600,
    "signal": 8,
    "on-click": "pkill -SIGRTMIN+8 waybar",
    "format": "{text}",
    "min-length": 7,
    "align": 1,
    "justify": "right",
    "tooltip": true
},


  "pulseaudio": {
    "format": "<span color='#cba6f7'>{icon} </span><span color='#cba6f7'>{volume:>3}%</span>",
    "format-bluetooth": "<span color='#cba6f7'>{icon}</span>  <span color='#cba6f7'>{volume:>3}%</span>",
    "format-muted": "<span color='#cba6f7'>󰝟 </span><span color='#cba6f7'> --%</span>",
    "min-length": 7,
    "align": 1,
    "justify": "right",
    "tooltip": false,
    "on-click": "walker --provider wireplumber",
    "on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 10%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 10%-",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        "",
      ]
    }
  },
  "custom/microphone": {
    "exec": "~/.config/waybar/scripts/microphone.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "on-click": "walker --provider wireplumber",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#cba6f7'>{icon}</span> <span color='#cba6f7'>{capacity:>3}%</span>",
    "format-charging": "<span color='#cba6f7'>󰂄</span> <span color='#cba6f7'>{capacity:>3}%</span>",
    "min-length": 6,
    "align": 1,
    "justify": "right",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click": "power-profile",
    "on-click-right": "power-profile status"
  },
  "custom/network": {
    "exec": "~/.config/waybar/scripts/network-speed.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{text}",
    "tooltip": true,
    "min-length": 8,
    "align": 1,
    "justify": "right",
    "on-click": "wezterm start --class Gazelle -- gazelle",
    "on-click-right": "wezterm start --class Network -- nmtui-connect"
  },

  "custom/kanata": {
    "exec": "~/.config/waybar/scripts/kanata-status.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{text}",
    "tooltip": true,
    "on-click": "~/.local/bin/toggle-kanata"
  },
  "custom/input": {
    "exec": "~/.config/waybar/scripts/input-status.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{text}",
    "min-length": 5,
    "align": 1,
    "justify": "right",
    "tooltip": true
  },
  "disk":{
	"interval": 30,
  "path": "/home",
	"format": "<span color='#cba6f7'> </span><span color='#cba6f7'>{specific_free:>4.0f}G</span>",
    "min-length": 7,
    "align": 1,
    "justify": "right",
	"unit": "GB",
    "on-click": "wezterm start --class Btop -- btop"
},
}
