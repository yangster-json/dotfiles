{
    "label": "lock",
    "action": "swaylock -f",
    "text": "Lock",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "hyprctl dispatch exit",
    "text": "Logout",
    "keybind": "e"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}
{
    "label": "nightlight",
    "action": "systemctl --user is-active --quiet gammastep.service && systemctl --user kill --signal=USR1 gammastep.service || systemctl --user start gammastep.service",
    "text": "Night light",
    "keybind": "n"
}
