# --- claude: secrets — never commit ---
# .mcp.json contains jira/confluence personal access tokens
claude/.credentials.json
claude/.mcp.json
# jira/confluence PATs used by skills/atlassian
claude/.atlassian.env

# --- claude: machine-local settings ---
claude/settings.local.json
claude/.claude/

# --- claude: runtime state, caches, session data ---
claude/projects/
claude/sessions/
claude/session-env/
claude/shell-snapshots/
claude/file-history/
claude/history.jsonl
claude/cache/
claude/paste-cache/
claude/backups/
claude/downloads/
claude/jobs/
claude/daemon*
claude/statsig/
claude/todos/
claude/plugins/marketplaces/
claude/plugins/cache/
claude/plugins/installed_plugins.json
claude/plugins/plugin-catalog-cache.json
claude/statusline-cache/
claude/tasks/
claude/plans/
claude/-augment.log
claude/stats-cache.json
claude/mcp-needs-auth-cache.json
claude/policy-limits.json
claude/remote-settings.json
claude/.cost-actuals.json
claude/.last-cleanup
claude/.last-update-result.json
# sdd's per-project learnings cache, keyed by munged repo path — same
# convention as cost-actuals.json. claude/sdd-learnings/_global/ is the
# GLOBAL scope and stays tracked.
claude/sdd-learnings/*/
!claude/sdd-learnings/_global/

# python bytecode from the sdd script tests
__pycache__/

# --- pi: secrets, runtime state, and installed packages ---
pi/agent/.atlassian.env
pi/agent/.atlassian-cloud.env
pi/agent/auth.json
pi/agent/models-store.json
pi/agent/trust.json
pi/agent/sessions/
pi/agent/npm/
pi/node_modules/
pi/package.json
pi/package-lock.json

# --- oh-my-zsh: upstream git clones — reinstall on new machines: ---
# git clone https://github.com/jeffreytse/zsh-vi-mode ~/.oh-my-zsh/custom/plugins/zsh-vi-mode
oh-my-zsh-custom/plugins/zsh-vi-mode/
# git clone https://github.com/zsh-users/zsh-syntax-highlighting ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting
oh-my-zsh-custom/plugins/zsh-syntax-highlighting/
