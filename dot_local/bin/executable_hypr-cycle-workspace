#!/usr/bin/env bash
# Focus the next/previous instantiated workspace on the focused monitor only.
set -euo pipefail

case ${1:-} in
    next) direction=1 ;;
    prev) direction=-1 ;;
    *)
        printf 'usage: %s {next|prev}\n' "${0##*/}" >&2
        exit 64
        ;;
esac

active_workspace=$(hyprctl activeworkspace -j)
monitor=$(jq -er '.monitor' <<<"$active_workspace")
current=$(jq -er '.id | select(. > 0)' <<<"$active_workspace") || exit 0

mapfile -t workspaces < <(
    hyprctl workspaces -j |
        jq -r --arg monitor "$monitor" \
            'map(select(.monitor == $monitor and .id > 0)) | sort_by(.id) | .[].id'
)

((${#workspaces[@]} > 1)) || exit 0

for index in "${!workspaces[@]}"; do
    if [[ ${workspaces[index]} == "$current" ]]; then
        target_index=$(( (index + direction + ${#workspaces[@]}) % ${#workspaces[@]} ))
        hyprctl dispatch "hl.dsp.focus({ workspace = ${workspaces[target_index]} })"
        exit 0
    fi
done

exit 0
