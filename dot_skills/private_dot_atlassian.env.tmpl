# jira/confluence PATs — gitignored, read by skills/atlassian/atl.py
{{- $jiraPersonalToken := get . "jiraPersonalToken" -}}
{{- $confluencePersonalToken := get . "confluencePersonalToken" -}}
{{- if not $jiraPersonalToken }}{{ warnf "jiraPersonalToken is unset; leaving JIRA_PERSONAL_TOKEN empty" }}{{ end -}}
{{- if not $confluencePersonalToken }}{{ warnf "confluencePersonalToken is unset; leaving CONFLUENCE_PERSONAL_TOKEN empty" }}{{ end -}}
JIRA_URL=https://jira.purestorage.com
JIRA_PERSONAL_TOKEN={{ $jiraPersonalToken }}
CONFLUENCE_URL=https://wiki.purestorage.com
CONFLUENCE_PERSONAL_TOKEN={{ $confluencePersonalToken }}
