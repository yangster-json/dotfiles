{{- $profile := index .hostProfiles .chezmoi.hostname | default "default" -}}
{{- $models := index .profiles $profile "models" -}}
{
  "defaultProvider": "{{ $models.provider }}",
  "defaultModel": "{{ $models.default }}",
  "lastChangelogVersion": "0.84.2",
  "compaction": {
    "enabled": false
  },
  "defaultThinkingLevel": "medium",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "{{ $models.luna }}",
        "thinking": "low"
      },
      "delegate": {
        "model": "{{ $models.luna }}",
        "thinking": "low"
      },
      "researcher": {
        "model": "{{ $models.terra }}",
        "thinking": "medium"
      },
      "worker": {
        "model": "{{ $models.terra }}",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "{{ $models.terra }}",
        "thinking": "high"
      },
      "oracle": {
        "model": "{{ $models.sol }}",
        "thinking": "high"
      },
      "advisor": {
        "model": "{{ $models.sol }}",
        "thinking": "high"
      }
    }
  },
  "theme": "dark",
  "packages": [
    {
      "source": "npm:pi-ketch@0.1.6",
      "extensions": [],
      "skills": []
    },
    "npm:pi-mcp-adapter@2.23.0",
    "npm:pi-vim-flash",
    "npm:pi-experiences",
    "npm:@narumitw/pi-btw",
    "npm:pi-subagents",
    "npm:pi-memory"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen"
}
