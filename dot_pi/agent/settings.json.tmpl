{{- $profile := index .hostProfiles .chezmoi.hostname | default "default" -}}
{{- $models := index .profiles $profile "models" -}}
{{- $isWork := eq $profile "fw-work" -}}
{
  "defaultProvider": "{{ $models.provider }}",
  "defaultModel": "{{ $models.default }}",
  "lastChangelogVersion": "0.85.1",
  "compaction": {
    "enabled": false
  },
  "defaultThinkingLevel": "high",
  "subagents": {
    {{- if $isWork }}
    "defaultExtensions": [
      "/u/jasyang/.config/everpure-foundry/pi-extension"
    ],
    {{- end }}
    "agentOverrides": {
      "scout": {
        "model": "{{ $models.luna }}",
        "thinking": "low"
      },
      "delegate": {
        "model": "{{ $models.luna }}",
        "thinking": "low"
      },
      "researcher": {
        "model": "{{ $models.terra }}",
        "thinking": "medium"
      },
      "worker": {
        "model": "{{ $models.terra }}",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "{{ $models.terra }}",
        "thinking": "high"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      },
      "advisor": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      }
    }
  },
  "theme": "dark",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-vim-flash",
    "npm:pi-experiences",
    "npm:@narumitw/pi-btw",
    "npm:pi-subagents",
    "npm:pi-memory",
    "npm:pi-ketch@0.1.6",
    "npm:acp-headroom-pi@0.1.2"{{ if not $isWork }},
    "npm:pi-chatgpt-limit"{{ end }}
  ],
  "terminal": {
    "showTerminalProgress": true,
    "images": "kitty"
  },
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.4",
    "openai-codex/gpt-5.4-mini",
    "openai-codex/gpt-5.5"
  ]
}
