{{- $profile := index .hostProfiles .chezmoi.hostname | default "default" -}}
{{- $models := index .profiles $profile "models" -}}
{{- $isWork := eq $profile "fw-work" -}}
{{- $acpTools := ternary "" (`, "compress", "decompress", "search_context", "acp_status", "headroom_retrieve"`) $isWork -}}
{{- $localSettings := dict -}}
{{- $settingsPath := joinPath .chezmoi.homeDir ".pi" "agent" "settings.json" -}}
{{- if stat $settingsPath -}}
{{- $localSettings = include $settingsPath | fromJson -}}
{{- end -}}
{
  "defaultProvider": "{{ $models.provider }}",
  "defaultModel": "{{ $models.default }}",
  {{- if hasKey $localSettings "lastChangelogVersion" }}
  "lastChangelogVersion": {{ index $localSettings "lastChangelogVersion" | toJson }},
  {{- end }}
  "compaction": {
    "enabled": {{ $isWork }}
  },
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultSubagentOnlyExtensions": [
      {{- if $isWork }}
      "/u/jasyang/.config/everpure-foundry/pi-extension"
      {{- else }}
      "{{ .chezmoi.homeDir }}/.pi/agent/npm/node_modules/acp-headroom-pi/dist/index.js"
      {{- end }}
    ],
    "agentOverrides": {
      "scout": {
        "model": "{{ $models.low }}",
        "thinking": "low",
        "tools": ["read", "grep", "find", "ls", "bash", "write", "contact_supervisor"{{ $acpTools }}]
      },
      "delegate": {
        "model": "{{ $models.low }}",
        "thinking": "low",
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor"{{ $acpTools }}]
      },
      "researcher": {
        "model": "{{ $models.mid }}",
        "thinking": "medium"
      },
      "worker": {
        "model": "{{ $models.mid }}",
        "thinking": "medium",
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor"{{ $acpTools }}]
      },
      "reviewer": {
        "model": "{{ $models.mid }}",
        "thinking": "high",
        "tools": ["read", "grep", "find", "ls", "watchdog_diff", "contact_supervisor"{{ $acpTools }}]
      },
      "oracle": {
        "model": "{{ $models.top }}",
        "thinking": "high",
        "tools": ["read", "grep", "find", "ls", "bash"{{ $acpTools }}]
      },
      "advisor": {
        "model": "{{ $models.top }}",
        "thinking": "high"
      }
    }
  },
  "theme": "catppuccin-mocha-mauve",
  "packages": [
    "npm:pi-vim-flash",
    "npm:@narumitw/pi-btw",
    "npm:pi-subagents",
    "npm:pi-memory",
    "npm:pi-ketch@0.1.6",
    {{- if not $isWork }}
    "npm:acp-headroom-pi@0.1.2",
    {{- else }}
    "git:github.com/pure-shared/pi-provider-gpulab",
    {{- end }}
    "npm:pi-loop-police"{{ if not $isWork }},
    "npm:pi-google-services",
    "npm:pi-chatgpt-limit"{{ end }}
  ],
  "terminal": {
    "showTerminalProgress": true,
    "images": "auto"
  },
  "tuiMode": "fullscreen",
  "hideThinkingBlock": false,
  "enabledModels": {{ $models.enabled | toJson }},
  "enableInstallTelemetry": false
}
