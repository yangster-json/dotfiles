{{- $profile := index .hostProfiles .chezmoi.hostname | default "default" -}}
{{- $models := index .profiles $profile "models" -}}
{{- $isWork := eq $profile "fw-work" -}}
{
  "defaultProvider": "{{ $models.provider }}",
  "defaultModel": "{{ $models.default }}",
  "lastChangelogVersion": "0.99.1",
  "compaction": {
    "enabled": false
  },
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultSubagentOnlyExtensions": [
      {{- if $isWork }}
      "/u/jasyang/.config/everpure-foundry/pi-extension",
      {{- end }}
      "{{ .chezmoi.homeDir }}/.pi/agent/npm/node_modules/acp-headroom-pi/dist/index.js"
    ],
    "agentOverrides": {
      "scout": {
        "model": "{{ $models.low }}",
        "thinking": "low",
        "tools": ["read", "grep", "find", "ls", "bash", "write", "contact_supervisor", "compress", "decompress", "search_context", "acp_status", "headroom_retrieve"]
      },
      "delegate": {
        "model": "{{ $models.low }}",
        "thinking": "low",
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor", "compress", "decompress", "search_context", "acp_status", "headroom_retrieve"]
      },
      "researcher": {
        "model": "{{ $models.mid }}",
        "thinking": "medium"
      },
      "worker": {
        "model": "{{ $models.mid }}",
        "thinking": "medium",
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write", "contact_supervisor", "compress", "decompress", "search_context", "acp_status", "headroom_retrieve"]
      },
      "reviewer": {
        "model": "{{ $models.mid }}",
        "thinking": "high",
        "tools": ["read", "grep", "find", "ls", "watchdog_diff", "contact_supervisor", "compress", "decompress", "search_context", "acp_status", "headroom_retrieve"]
      },
      "oracle": {
        "model": "{{ $models.top }}",
        "thinking": "high",
        "tools": ["read", "grep", "find", "ls", "bash", "compress", "decompress", "search_context", "acp_status", "headroom_retrieve"]
      },
      "advisor": {
        "model": "{{ $models.top }}",
        "thinking": "high"
      }
    }
  },
  "theme": "catppuccin-mocha-mauve",
  "packages": [
    "npm:pi-vim-flash",
    "npm:@narumitw/pi-btw",
    "npm:pi-subagents",
    "npm:pi-memory",
    "npm:pi-ketch@0.1.6",
    "npm:acp-headroom-pi@0.1.2",
    {{- if $isWork }}
    "git:github.com/pure-shared/pi-provider-gpulab",
    {{- end }}
    "npm:pi-loop-police"{{ if not $isWork }},
    "npm:pi-google-services",
    "npm:pi-chatgpt-limit"{{ end }}
  ],
  "terminal": {
    "showTerminalProgress": true,
    "images": "kitty"
  },
  "tuiMode": "fullscreen",
  "hideThinkingBlock": false,
  "enabledModels": [
    {{- if $isWork }}
    "gpulab/claude-opus-5-5",
    "gpulab/gpt-6-astra-claude-compatible[1m]",
    "gpulab/gpt-6-sol-claude-compatible[1m]",
    "gpulab/gpt-6-luna-claude-compatible[1m]",
    "gpulab/Qwen3.8-27B-claude-compatible",
    "gpulab/Kimi-K3-lab-claude-compatible[1m]",
    "gpulab/glm-5.3-flash-claude-compatible"
    {{- else }}
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-5.3-codex-spark",
    "openai-codex/gpt-5.4",
    "openai-codex/gpt-5.4-mini",
    "openai-codex/gpt-5.5"
    {{- end }}
  ],
  "enableInstallTelemetry": false
}
