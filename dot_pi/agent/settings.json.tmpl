{{- $profile := index .hostProfiles .chezmoi.hostname | default "default" -}}
{{- $models := index .profiles $profile "models" -}}
{{- $isWork := eq $profile "fw-work" -}}
{
  "defaultProvider": "{{ $models.provider }}",
  "defaultModel": "{{ $models.default }}",
  "lastChangelogVersion": "0.84.3",
  "compaction": {
    "enabled": false
  },
  "defaultThinkingLevel": "high",
  "subagents": {
    {{- if $isWork }}
    "defaultExtensions": [
      "/u/jasyang/.config/everpure-foundry/pi-extension"
    ],
    {{- end }}
    "agentOverrides": {
      "scout": {
        "model": "{{ $models.luna }}",
        "thinking": "low"
      },
      "delegate": {
        "model": "{{ $models.luna }}",
        "thinking": "low"
      },
      "researcher": {
        "model": "{{ $models.terra }}",
        "thinking": "medium"
      },
      "worker": {
        "model": "{{ $models.terra }}",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "{{ $models.terra }}",
        "thinking": "high"
      },
      "oracle": {
        "model": "{{ $models.sol }}",
        "thinking": "high"
      },
      "advisor": {
        "model": "{{ $models.sol }}",
        "thinking": "high"
      }
    }
  },
  "theme": "dark",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-vim-flash",
    "npm:pi-experiences",
    "npm:@narumitw/pi-btw",
    "npm:pi-subagents",
    "npm:pi-memory",
    "npm:pi-ketch@0.1.6"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen"
}
