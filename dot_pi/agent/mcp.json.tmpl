{{- $profile := index .hostProfiles .chezmoi.hostname | default "default" -}}
{{- $isWork := eq $profile "fw-work" -}}
{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "exposure": "direct",
      "headers": { "User-Agent": "pi-coding-agent" }
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "google-services": {
      "command": {{ joinPath .chezmoi.homeDir ".local" "bin" "pi-google-services" | toJson }},
      "args": [
        "serve"
      ],
      "enabled": {{ not $isWork }}
    }{{ if $isWork }},
    "glean": {
      "url": "https://purestorage-be.glean.com/mcp/glean-mcp"
    }{{ end }}
  }
}
