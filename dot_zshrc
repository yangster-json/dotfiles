
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(git)
plugins+=(zsh-vi-mode)

DISABLE_MAGIC_FUNCTIONS=true

ZVM_READKEY_ENGINE=zle
ZVM_KEYTIMEOUT=0.05

function zvm_config() {
  ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT
}

source $ZSH/oh-my-zsh.sh

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

triage-get () {
  local TRIAGE_DIR="/tmp/triage"
  pushd ${TRIAGE_DIR}
  triage build $1 artifacts --fetch --no-all-blades --no-binary |& tee ${TRIAGE_DIR}/.triage_cache
  if [[ ${pipestatus[1]} = 0 ]]; then
      export JOB_DIR=$(readlink -f $(grep "artifacts saved to" ${TRIAGE_DIR}/.triage_cache | grep -Po "\./\S+"))
      echo "JOB_DIR=${JOB_DIR}"
  fi
  popd
}
 
triage-clean() {
    local triage_dirs=(/tmp/triage/t_*) &>/dev/null
    if [[ -n ${triage_dirs} ]]; then
        rm -rf /tmp/triage/t_*
    fi
}
 
triage-clean-get() {
    triage-clean
    triage-get "$@"
}
 
alias tg=triage-get
alias tcg=triage-clean-get

alias rm='rm -r'
alias rmrf='sudo rm -rf'
alias mv='mv -v'
alias cp='cp -v'
alias jk='cd ..' # VERY GOOD
alias color='/usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/gawin/bash-colors-256/master/colors)"' # tests 256 colors
alias vim='vim -X'
alias findtext="grep -rnw . -ie" # for recursively searching text within files
alias listssh="ps -AF | grep ssh" # for listing ssh sessions that hang

if [[ -n $WSL_DISTRO_NAME ]]; then
  pbcopy() { clip.exe; }
  pbpaste() { powershell.exe -NoProfile -Command Get-Clipboard; }
fi

if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init --cmd cd zsh)"
fi
if command -v fzf >/dev/null 2>&1; then
  zvm_after_init_commands+=('source <(fzf --zsh)')
fi
[[ -f $ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && zvm_after_init_commands+=('source $ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh')
[[ -f $ZSH_CUSTOM/catppuccin/catppuccin_mocha-zsh-syntax-highlighting.zsh ]] && zvm_after_init_commands+=('source $ZSH_CUSTOM/catppuccin/catppuccin_mocha-zsh-syntax-highlighting.zsh')
zvm_after_init_commands+=('bindkey -M viins "^[[200~" bracketed-paste')
zvm_after_init_commands+=('bindkey -M vicmd "^[[200~" bracketed-paste')

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi

export PATH="$HOME/.local/bin:$PATH"
[[ -d /opt/nvim-linux-x86_64/bin ]] && export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
[[ -d "$HOME/datastore-ai-tools" ]] && export PATH="$HOME/datastore-ai-tools:$PATH"
[[ -d "$HOME/.pi/agent/npm/node_modules/.bin" ]] && export PATH="$HOME/.pi/agent/npm/node_modules/.bin:$PATH"
[[ -d "$HOME/.claude/sdd-plugin/bin" ]] && export PATH="$HOME/.claude/sdd-plugin/bin:$PATH"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
