{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "5",
    "EDITOR": "nvim",
    "VISUAL": "nvim"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.py"
  },
  "extraKnownMarketplaces": {
    "jasyang-dotfiles": {
      "source": {
        "source": "directory",
        "path": "/u/jasyang/.claude"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "enabledPlugins": {
    "sdd@jasyang-dotfiles": true
  }
}
