{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "5",
    "EDITOR": "nvim",
    "VISUAL": "nvim"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pure_astyle_format.sh",
            "timeout": 30,
            "statusMessage": "pure_astyle"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "find ~/.claude/session-env -mindepth 1 -maxdepth 1 -type d -empty -mtime +7 -delete 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "prune session-env",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.py"
  },
  "enabledPlugins": {
    "sdd@jasyang-dotfiles": true
  },
  "extraKnownMarketplaces": {
    "jasyang-dotfiles": {
      "source": {
        "source": "directory",
        "path": "/u/jasyang/.claude"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": true
}
