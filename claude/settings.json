{
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "5",
    "EDITOR": "nvim",
    "VISUAL": "nvim"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/sdd/hooks/require-plan-approval.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/sdd/statusline.sh"
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": false
}
