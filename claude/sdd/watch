#!/usr/bin/env python3
"""sdd progress dashboard — renders specs/<slug>/state.md in the terminal.

usage:
  .claude/sdd/watch                render once
  .claude/sdd/watch --loop [sec]   clear + re-render every sec (default 2)
  .claude/sdd/watch <slug>         view a specific feature (default: specs/ACTIVE)

or under watch:  watch -c -n2 .claude/sdd/watch
meant to live in a tmux side pane while /sdd:run works.
"""
import os
import re
import sys
import time

DIM, BLD, RST = "\033[2m", "\033[1m", "\033[0m"
GRN, YLW, RED, CYN = "\033[32m", "\033[33m", "\033[31m", "\033[36m"

PHASES = ["research", "spec", "plan", "implement", "review", "test", "commit"]
STATUS_COLOR = {"done": GRN, "in_progress": YLW, "blocked": RED, "pending": DIM}


def find_root():
    d = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(d, "specs")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def field(text, key, default=""):
    m = re.search(rf"^{key}:\s*(.+?)\s*(?:<!--.*)?$", text, re.M)
    return (m.group(1).strip() if m else default) or default


def sections(text):
    out, name = {}, None
    for line in text.splitlines():
        m = re.match(r"^##\s+(.*)", line)
        if m:
            name = m.group(1).strip().lower()
            out[name] = []
        elif name:
            out[name].append(line)
    return out


def task_rows(lines):
    rows = []
    for line in lines:
        if not line.lstrip().startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) >= 4 and re.fullmatch(r"[TFQ]\d+", cells[0]):
            rows.append(cells + [""] * (6 - len(cells)))
    return rows


def ladder(phase, plan_ok, review_ok):
    def gate(flag, label):
        mark = f"{GRN}✔{RST}" if flag else f"{DIM}─{RST}"
        return f"{DIM}[{label} {RST}{mark}{DIM}]{RST}"

    cur = PHASES.index(phase) if phase in PHASES else len(PHASES)
    parts = []
    for i, p in enumerate(PHASES):
        if phase == "done" or i < cur:
            parts.append(f"{GRN}{p} ✔{RST}")
        elif i == cur:
            parts.append(f"{BLD}{YLW}▶ {p}{RST}")
        else:
            parts.append(f"{DIM}{p}{RST}")
        if p == "plan":
            parts.append(gate(plan_ok, "gate1"))
        if p == "review":
            parts.append(gate(review_ok, "gate2"))
    if phase == "done":
        parts.append(f"{GRN}{BLD}done ✔{RST}")
    return "  ".join(parts)


def clean(lines, limit=None):
    keep = [l.strip() for l in lines
            if l.strip() and not l.strip().startswith("<!--")]
    return keep[-limit:] if limit else keep


def render(root):
    try:
        slug = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") \
            else open(os.path.join(root, "specs", "ACTIVE")).read().strip()
        if slug.startswith("worktree:"):
            # feature lives in a spun-off worktree; follow the pointer
            root = os.path.join(root, slug.split(":", 1)[1].strip())
            slug = open(os.path.join(root, "specs", "ACTIVE")).read().strip()
        text = open(os.path.join(root, "specs", slug, "state.md")).read()
    except OSError:
        return f"{DIM}no active sdd feature (specs/ACTIVE not found){RST}"

    phase = field(text, "phase", "?").split()[0]
    jira = field(text, "jira", "none")
    upstream = field(text, "upstream", "none")
    testbed, bay = field(text, "hw_testbed", "none"), field(text, "hw_bay", "")
    sec = sections(text)
    rows = task_rows(sec.get("tasks", []))
    rule = f"{DIM}{'─' * 78}{RST}"

    out = []
    hdr = f" {BLD}sdd: {slug}{RST}"
    if jira != "none":
        hdr += f"   {DIM}jira{RST} {jira}"
    if upstream != "none":
        hdr += f"   {DIM}⇡ {upstream}{RST}"
    if testbed != "none":
        hdr += f"   {DIM}hw{RST} {testbed}/{bay}"
    out += [hdr, rule,
            " " + ladder(phase, field(text, "plan_approved") == "yes",
                         field(text, "review_approved") == "yes"), ""]

    if rows:
        counts = {}
        for r in rows:
            counts[r[3]] = counts.get(r[3], 0) + 1
        summary = " · ".join(
            f"{STATUS_COLOR.get(s, '')}{counts[s]} {s}{RST}"
            for s in ["done", "in_progress", "blocked", "pending"] if s in counts)
        out += [f" {BLD}tasks{RST}  {summary}", rule]
        for r in rows:
            c = STATUS_COLOR.get(r[3], "")
            title = r[1][:44] + ("…" if len(r[1]) > 44 else "")
            dep = f"  {DIM}← {r[4]}{RST}" if r[4] and r[4] not in ("—", "-", "") else ""
            cx = {"simple": "sim", "standard": "std"}.get(r[2], r[2][:3])
            out.append(f"  {r[0]:<4} {title:<46} {DIM}{cx:<4}{RST} {c}{r[3]}{RST}{dep}")
        out.append("")

    for name, limit in [("amendments", None), ("waived findings", None),
                        ("tests run", None), ("log", 5)]:
        lines = clean(sec.get(name, []), limit)
        if lines:
            out.append(f" {BLD}{name}{RST}")
            out += [f"  {DIM}{l}{RST}" for l in lines]
            out.append("")
    return "\n".join(out)


def main():
    root = find_root()
    if not root:
        print(f"{DIM}not inside an sdd project (no specs/ directory found){RST}")
        return
    if "--loop" in sys.argv:
        idx = sys.argv.index("--loop")
        interval = float(sys.argv[idx + 1]) if len(sys.argv) > idx + 1 else 2.0
        try:
            while True:
                print("\033[2J\033[H" + render(root))
                time.sleep(interval)
        except KeyboardInterrupt:
            pass
    else:
        print(render(root))


if __name__ == "__main__":
    main()
