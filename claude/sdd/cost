#!/usr/bin/env python3
"""sdd cost monitor — per-agent costs and auto-calibrated estimates from
claude code transcripts.

usage:
  .claude/sdd/cost [project-root]    summary (default root: cwd)
  .claude/sdd/cost --agents          per-agent cost table, latest session
  .claude/sdd/cost --sessions N      recent sessions table
  .claude/sdd/cost --brief           one line (used by /sdd:run at gates)
  .claude/sdd/cost --loop [sec]      self-refreshing (default 30)

token counts are exact (transcript usage records, deduped by message id).
dollars start from the PRICES table below and are AUTO-CALIBRATED: the sdd
statusline caches claude code's as-billed session totals into
.claude/.cost-actuals.json, and this script scales its estimates by the
median actual/estimate ratio across those sessions. pricing drift corrects
itself once a few sessions have run; the table is only the starting point.
"""
import glob
import json
import os
import re
import sys
import time
from datetime import datetime, timedelta, timezone

# usd per million tokens: input, output, cache_write, cache_read.
# base rates only — displayed dollars are scaled by the calibration factor.
PRICES = {
    "opus":   (5.0, 25.0, 6.25, 0.50),
    "fable":  (5.0, 25.0, 6.25, 0.50),
    "sonnet": (3.0, 15.0, 3.75, 0.30),
    "haiku":  (1.0, 5.0, 1.25, 0.10),
}
DEFAULT_PRICE = PRICES["sonnet"]

DIM, BLD, RST, GRN, YLW = "\033[2m", "\033[1m", "\033[0m", "\033[32m", "\033[33m"


def projects_dir(root):
    munged = re.sub(r"[^a-zA-Z0-9]", "-", os.path.abspath(root))
    bases = []
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        bases.append(os.environ["CLAUDE_CONFIG_DIR"])
    bases.append(os.path.expanduser("~/.claude"))
    for base in bases:
        d = os.path.join(base, "projects", munged)
        if os.path.isdir(d):
            return d
    return None


def load(pdir):
    """all user/assistant entries, with uuid links for agent-chain grouping."""
    entries = []
    for path in glob.glob(os.path.join(pdir, "*.jsonl")):
        session = os.path.basename(path)[:-6]
        try:
            with open(path) as f:
                for line in f:
                    try:
                        e = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if e.get("type") not in ("assistant", "user"):
                        continue
                    entries.append({
                        "uuid": e.get("uuid"),
                        "parent": e.get("parentUuid"),
                        "side": bool(e.get("isSidechain")),
                        "type": e["type"],
                        "session": session,
                        "ts": e.get("timestamp", ""),
                        "msg": e.get("message") or {},
                    })
        except OSError:
            continue
    return entries


def usage_records(entries):
    """one record per assistant message (streamed chunks share an id)."""
    seen = {}
    for e in entries:
        if e["type"] != "assistant":
            continue
        u = e["msg"].get("usage")
        if not u:
            continue
        key = e["msg"].get("id") or e["uuid"]
        seen[key] = dict(e, model=e["msg"].get("model", "?"),
                         tin=u.get("input_tokens", 0),
                         tout=u.get("output_tokens", 0),
                         cw=u.get("cache_creation_input_tokens", 0),
                         cr=u.get("cache_read_input_tokens", 0))
    return list(seen.values())


def est(rec):
    p = DEFAULT_PRICE
    for name, price in PRICES.items():
        if name in rec["model"]:
            p = price
            break
    return (rec["tin"] * p[0] + rec["tout"] * p[1]
            + rec["cw"] * p[2] + rec["cr"] * p[3]) / 1e6


def when(rec):
    try:
        return datetime.fromisoformat(rec["ts"].replace("Z", "+00:00"))
    except ValueError:
        return datetime.min.replace(tzinfo=timezone.utc)


def agg(recs):
    t = {"tin": 0, "tout": 0, "cw": 0, "cr": 0, "usd": 0.0}
    for r in recs:
        for k in ("tin", "tout", "cw", "cr"):
            t[k] += r[k]
        t["usd"] += est(r)
    read_in = t["tin"] + t["cw"] + t["cr"]
    t["cached_pct"] = 100 * t["cr"] / read_in if read_in else 0
    return t


def load_actuals(root):
    try:
        with open(os.path.join(root, ".claude", ".cost-actuals.json")) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def calibration(recs, actuals):
    """median as-billed/estimate ratio over sessions where both are known."""
    ratios = []
    for sid, a in actuals.items():
        actual = (a or {}).get("usd", 0)
        e = agg([r for r in recs if r["session"] == sid])["usd"]
        if actual > 0.10 and e > 0.10:
            ratios.append(actual / e)
    if not ratios:
        return 1.0, 0
    ratios.sort()
    return ratios[len(ratios) // 2], len(ratios)


def agent_chains(entries, session):
    """group sidechain entries into per-agent-invocation chains."""
    byid = {e["uuid"]: e for e in entries
            if e["session"] == session and e["uuid"]}

    def root_of(e):
        while e["parent"] and e["parent"] in byid and byid[e["parent"]]["side"]:
            e = byid[e["parent"]]
        return e["uuid"]

    chains = {}
    for e in byid.values():
        if e["side"]:
            chains.setdefault(root_of(e), []).append(e)
    return byid, chains


def text_of(msg):
    c = msg.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        for b in c:
            if isinstance(b, dict) and b.get("type") == "text":
                return b.get("text", "")
    return ""


def fmt_tok(n):
    return f"{n/1e6:.1f}M" if n >= 1e6 else f"{n/1e3:.0f}k" if n >= 1e3 else str(n)


def row(label, recs, factor, width=14):
    t = agg(recs)
    return (f"  {label:<{width}} in {fmt_tok(t['tin']+t['cw']+t['cr']):>7}"
            f" {DIM}({t['cached_pct']:.0f}% cached){RST}"
            f"  out {fmt_tok(t['tout']):>6}   {GRN}${t['usd']*factor:.2f}{RST}")


def render(root, n_sessions=0, show_agents=False):
    pdir = projects_dir(root)
    if not pdir:
        return (f"{DIM}no claude code transcripts found for {root}\n"
                f"(no sessions run in this project yet){RST}")
    entries = load(pdir)
    recs = usage_records(entries)
    if not recs:
        return f"{DIM}transcripts exist but contain no usage records{RST}"

    actuals = load_actuals(root)
    factor, n_cal = calibration(recs, actuals)
    cal_note = (f"calibrated ×{factor:.2f} from {n_cal} sessions" if n_cal
                else "uncalibrated — base price table")

    now = datetime.now(timezone.utc)
    latest = max(recs, key=when)["session"]
    cur = [r for r in recs if r["session"] == latest]
    rule = f"{DIM}{'─' * 66}{RST}"

    sess_actual = (actuals.get(latest) or {}).get("usd")
    total_line = (f"{BLD}{GRN}${sess_actual:.2f}{RST} {DIM}(as billed){RST}"
                  if sess_actual
                  else f"{BLD}{GRN}${agg(cur)['usd']*factor:.2f}{RST}")

    out = [f" {BLD}sdd cost — {os.path.basename(os.path.abspath(root))}{RST}"
           f"   {DIM}{cal_note}{RST}", rule,
           f" {BLD}latest session{RST}",
           row("orchestrator", [r for r in cur if not r["side"]], factor),
           row("subagents", [r for r in cur if r["side"]], factor),
           f"  {'total':<14} {' ' * 36}{total_line}",
           "", f" {BLD}by model (latest session){RST}"]
    for m in sorted({r["model"] for r in cur}):
        out.append(row(m.replace("claude-", "")[:14],
                       [r for r in cur if r["model"] == m], factor))

    if show_agents:
        byid, chains = agent_chains(entries, latest)
        out += ["", f" {BLD}agents (latest session){RST}"]
        if not chains:
            out.append(f"  {DIM}no subagent activity in this session{RST}")
        ordered = sorted(chains.items(),
                         key=lambda kv: min(when(e) for e in kv[1]))
        for i, (root_id, chain) in enumerate(ordered, 1):
            ids = {e["uuid"] for e in chain}
            crecs = [r for r in cur if r["uuid"] in ids]
            t = agg(crecs)
            label = " ".join(text_of(byid.get(root_id, {}).get("msg", {})).split())[:38]
            model = (crecs[0]["model"].replace("claude-", "")[:12]
                     if crecs else "?")
            out.append(f"  {i:>2} {DIM}{model:<13}{RST}"
                       f" in {fmt_tok(t['tin']+t['cw']+t['cr']):>7}"
                       f" out {fmt_tok(t['tout']):>6}"
                       f" {GRN}${t['usd']*factor:>6.2f}{RST}  {DIM}{label}{RST}")

    day = [r for r in recs if when(r) > now - timedelta(days=1)]
    week = [r for r in recs if when(r) > now - timedelta(days=7)]
    out += ["", f" {BLD}windows{RST}   24h {GRN}${agg(day)['usd']*factor:.2f}{RST}"
                f"   7d {GRN}${agg(week)['usd']*factor:.2f}{RST}"
                f"   all {GRN}${agg(recs)['usd']*factor:.2f}{RST}"
                f"   {DIM}({len({r['session'] for r in recs})} sessions){RST}"]

    if n_sessions:
        out += ["", f" {BLD}recent sessions{RST}"
                    f"   {DIM}• = as billed (statusline cache){RST}"]
        by_start = sorted({r["session"] for r in recs},
                          key=lambda s: max(when(r) for r in recs
                                            if r["session"] == s),
                          reverse=True)
        for s in by_start[:n_sessions]:
            srecs = [r for r in recs if r["session"] == s]
            a = (actuals.get(s) or {}).get("usd")
            usd = (f"{GRN}${a:.2f}{RST} •" if a
                   else f"{GRN}${agg(srecs)['usd']*factor:.2f}{RST}")
            out.append(f"  {min(when(r) for r in srecs):%m-%d %H:%M}"
                       f"  {s[:8]}…  {len(srecs):>4} msgs   {usd}")
    return "\n".join(out)


def brief(root):
    pdir = projects_dir(root)
    entries = load(pdir) if pdir else []
    recs = usage_records(entries)
    if not recs:
        return "cost: no transcript data"
    actuals = load_actuals(root)
    factor, n_cal = calibration(recs, actuals)
    latest = max(recs, key=when)["session"]
    cur = [r for r in recs if r["session"] == latest]
    orch = agg([r for r in cur if not r["side"]])["usd"] * factor
    sub = agg([r for r in cur if r["side"]])["usd"] * factor
    day = agg([r for r in recs
               if when(r) > datetime.now(timezone.utc) - timedelta(days=1)]
              )["usd"] * factor
    sess_actual = (actuals.get(latest) or {}).get("usd")
    total = f"${sess_actual:.2f} billed" if sess_actual \
        else f"${orch + sub:.2f} est"
    cal = f", cal ×{factor:.2f}" if n_cal else ", uncal"
    return (f"cost: session {total} (orch ${orch:.2f} + agents ${sub:.2f}"
            f"{cal}) · 24h ${day:.2f}")


def main():
    args = sys.argv[1:]
    root = next((a for a in args
                 if not a.startswith("-") and not a.replace(".", "").isdigit()),
                os.getcwd())
    if "--brief" in args:
        print(brief(root))
        return
    n = 0
    if "--sessions" in args:
        i = args.index("--sessions")
        n = int(args[i + 1]) if len(args) > i + 1 and args[i + 1].isdigit() else 10
    show_agents = "--agents" in args
    if "--loop" in args:
        i = args.index("--loop")
        interval = float(args[i + 1]) if len(args) > i + 1 else 30.0
        try:
            while True:
                print("\033[2J\033[H" + render(root, n, show_agents))
                time.sleep(interval)
        except KeyboardInterrupt:
            pass
    else:
        print(render(root, n, show_agents))


if __name__ == "__main__":
    main()
