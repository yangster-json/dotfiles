#!/usr/bin/env python3
# sdd-watch — thin alias. the two renderers were collapsed into sdd-status;
# this forwards to `sdd-status --full` so the documented tmux-side-pane usage
# (sdd-watch, sdd-watch --loop [sec], sdd-watch <slug>) still works unchanged.
import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
os.execv(sys.executable,
         [sys.executable, os.path.join(here, "sdd-status"), "--full",
          *sys.argv[1:]])
